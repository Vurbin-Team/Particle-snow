diff --git a/src/client/java/cinematic/snowstorm/effects/FrostBreath.java b/src/client/java/cinematic/snowstorm/effects/FrostBreath.java
new file mode 100644
index 0000000..e6d217a
--- /dev/null
+++ b/src/client/java/cinematic/snowstorm/effects/FrostBreath.java
@@ -0,0 +1,70 @@
+package cinematic.snowstorm.effects;
+
+import cinematic.snowstorm.config.SnowfallConfig;
+import cinematic.snowstorm.particle.ParticleTypes;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Frost breath: small puffs of vapor at the player's mouth while it is snowing and the player
+ * is outside (open sky, not underwater). Only the local player breathes.
+ */
+public final class FrostBreath {
+    private static final int PUFFS_PER_EXHALE = 3;
+    // Exhale speed in blocks per tick, relative to the player.
+    private static final double EXHALE_SPEED = 0.03;
+    // Share of the player's own motion the vapor starts with (1.0 = moves along with the player).
+    private static final double MOTION_INHERIT = 1.0;
+
+    private static int cooldown;
+    private static int puffsLeft;
+
+    private FrostBreath() {}
+
+    public static void tick(ClientLevel level, LocalPlayer player, boolean snowing) {
+        if (!SnowfallConfig.ENABLE_FROST_BREATH || !snowing || player == null
+                || player.isSpectator() || !player.isAlive() || player.isUnderWater()
+                || !level.canSeeSky(player.blockPosition())) {
+            puffsLeft = 0;
+            return;
+        }
+        if (!SnowfallConfig.BREATH_FIRST_PERSON
+                && Minecraft.getInstance().options.getCameraType().isFirstPerson()) {
+            puffsLeft = 0;
+            return;
+        }
+
+        if (puffsLeft > 0) {
+            puffsLeft--;
+            puff(level, player);
+            return;
+        }
+        if (--cooldown <= 0) {
+            double intervalTicks = Math.max(0.5, SnowfallConfig.BREATH_INTERVAL_SECONDS) * 20.0;
+            cooldown = (int) Math.max(5, intervalTicks * (0.8 + level.getRandom().nextDouble() * 0.4));
+            puffsLeft = PUFFS_PER_EXHALE - 1;
+            puff(level, player);
+        }
+    }
+
+    private static void puff(ClientLevel level, LocalPlayer player) {
+        Vec3 eye = player.getEyePosition();
+        Vec3 look = player.getLookAngle();
+        // Real movement during the last tick (not the smoothed value used for snow), so the
+        // vapor follows the actual walking direction: forward, sideways, backward, jumping.
+        double mx = player.getX() - player.xo;
+        double my = player.getY() - player.yo;
+        double mz = player.getZ() - player.zo;
+        // The exhaled air starts with the body's motion plus the exhale itself, then drag and
+        // wind take over in MyBreathParticle (so the puff trails behind a walking player).
+        level.addParticle(ParticleTypes.MY_BREATH,
+                eye.x + look.x * 0.32,
+                eye.y - 0.22 + look.y * 0.10,
+                eye.z + look.z * 0.32,
+                look.x * EXHALE_SPEED + mx * MOTION_INHERIT,
+                look.y * EXHALE_SPEED + 0.006 + my * MOTION_INHERIT,
+                look.z * EXHALE_SPEED + mz * MOTION_INHERIT);
+    }
+}
diff --git a/src/client/java/cinematic/snowstorm/effects/SpeedStreaks.java b/src/client/java/cinematic/snowstorm/effects/SpeedStreaks.java
new file mode 100644
index 0000000..b78c3d5
--- /dev/null
+++ b/src/client/java/cinematic/snowstorm/effects/SpeedStreaks.java
@@ -0,0 +1,140 @@
+package cinematic.snowstorm.effects;
+
+import cinematic.snowstorm.config.SnowfallConfig;
+import cinematic.snowstorm.particle.ParticleTypes;
+import cinematic.snowstorm.utils.SnowSpawnManager;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Speed streaks: while snowing and the player moves faster than a threshold (elytra, boats,
+ * falling, horses...), stretched streak particles rush past the camera.
+ * Streaks stand still in the world; the player's own motion makes them streak by.
+ */
+public final class SpeedStreaks {
+    // +1: a positive particle roll turns the sprite counter-clockwise on screen.
+    // If streaks lean the wrong way in game, set this to -1.
+    private static final float ROLL_SIGN = 1.0f;
+
+    // Half-size of the spawn area on screen, as a share of the depth (tangent of the half angle).
+    private static final double VIEW_HALF_WIDTH = 0.9;
+    private static final double VIEW_HALF_HEIGHT = 0.6;
+
+    private static final double BASE_RATE = 8.0;   // streaks per tick at density 1.0, full speed
+    private static final int MAX_PER_TICK = 24;
+
+    // Camera basis (right / up / forward) and eye position, refreshed every tick while active.
+    private static double ex, ey, ez;
+    private static double rx, ry, rz;
+    private static double ux, uy, uz;
+    private static double fx, fy, fz;
+    private static double vx, vy, vz;
+    private static boolean hasBasis;
+    private static float accumulator;
+
+    private SpeedStreaks() {}
+
+    public static void tick(ClientLevel level, LocalPlayer player, boolean snowing) {
+        if (!SnowfallConfig.ENABLE_SPEED_STREAKS || !snowing || player == null || player.isSpectator()) {
+            accumulator = 0f;
+            return;
+        }
+        Vec3 vel = SnowSpawnManager.getPlayerVelocity();
+        double speed = vel.length();
+        double threshold = Math.max(0.05, SnowfallConfig.STREAK_SPEED_THRESHOLD);
+        if (speed <= threshold || !level.canSeeSky(player.blockPosition())) {
+            accumulator = 0f;
+            return;
+        }
+
+        Vec3 eye = player.getEyePosition();
+        double yaw = Math.toRadians(player.getYRot());
+        double pitch = Math.toRadians(player.getXRot());
+        ex = eye.x; ey = eye.y; ez = eye.z;
+        fx = -Math.sin(yaw) * Math.cos(pitch);
+        fy = -Math.sin(pitch);
+        fz = Math.cos(yaw) * Math.cos(pitch);
+        rx = -Math.cos(yaw);
+        ry = 0.0;
+        rz = -Math.sin(yaw);
+        // up = right x forward
+        ux = ry * fz - rz * fy;
+        uy = rz * fx - rx * fz;
+        uz = rx * fy - ry * fx;
+        vx = vel.x; vy = vel.y; vz = vel.z;
+        hasBasis = true;
+
+        // 0 at the threshold, 1 at twice the threshold; never fully zero just above it.
+        double factor = Math.min(1.0, (speed - threshold) / threshold);
+        accumulator += (float) (BASE_RATE * Math.max(0.0, SnowfallConfig.STREAK_DENSITY) * (0.25 + 0.75 * factor));
+        int count = (int) accumulator;
+        accumulator -= count;
+        count = Math.min(count, MAX_PER_TICK);
+
+        double clearance = SnowfallConfig.STREAK_CENTER_CLEARANCE;
+        for (int i = 0; i < count; i++) {
+            // A random point inside the view frustum, 2.5..12.5 blocks in front of the camera,
+            // outside the cleared area in the middle of the screen (a few tries, then give up).
+            double d = 0.0, a = 0.0, b = 0.0;
+            boolean found = false;
+            for (int attempt = 0; attempt < 4 && !found; attempt++) {
+                d = 2.5 + level.getRandom().nextDouble() * 10.0;
+                double nx = level.getRandom().nextDouble() * 2.0 - 1.0;
+                double ny = level.getRandom().nextDouble() * 2.0 - 1.0;
+                a = nx * d * VIEW_HALF_WIDTH;
+                b = ny * d * VIEW_HALF_HEIGHT;
+                found = Math.hypot(nx, ny) >= clearance;
+            }
+            if (!found) continue;
+            level.addParticle(ParticleTypes.MY_SNOWSTREAK,
+                    ex + fx * d + rx * a + ux * b,
+                    ey + fy * d + ry * a + uy * b,
+                    ez + fz * d + rz * a + uz * b,
+                    0.0, 0.0, 0.0);
+        }
+    }
+
+    /**
+     * 0..1 visibility from the position on screen: 0 in the cleared middle of the screen,
+     * fading in to 1 over the next 20% of the view radius.
+     */
+    public static float centerFade(double x, double y, double z) {
+        double clearance = SnowfallConfig.STREAK_CENTER_CLEARANCE;
+        if (!hasBasis || clearance <= 0.0) return 1.0f;
+        double qx = x - ex, qy = y - ey, qz = z - ez;
+        double cz = Math.max(0.1, qx * fx + qy * fy + qz * fz);
+        double nx = (qx * rx + qy * ry + qz * rz) / cz / VIEW_HALF_WIDTH;
+        double ny = (qx * ux + qy * uy + qz * uz) / cz / VIEW_HALF_HEIGHT;
+        double t = (Math.hypot(nx, ny) - clearance) / 0.2;
+        return (float) Math.max(0.0, Math.min(1.0, t));
+    }
+
+    /** True once a streak is behind the player's eye (the player has flown past it). */
+    public static boolean isBehind(double x, double y, double z) {
+        if (!hasBasis) return false;
+        return (x - ex) * fx + (y - ey) * fy + (z - ez) * fz < 0.0;
+    }
+
+    /**
+     * Sprite rotation that lines a streak up with the direction it appears to move on screen.
+     * The sprite's long axis is vertical, so 0 = pointing up.
+     */
+    public static float streakRoll(double x, double y, double z) {
+        if (!hasBasis) return 0.0f;
+        double qx = x - ex, qy = y - ey, qz = z - ez;
+        // Point in camera space (x right, y up, z depth).
+        double cx = qx * rx + qy * ry + qz * rz;
+        double cy = qx * ux + qy * uy + qz * uz;
+        double cz = Math.max(0.1, qx * fx + qy * fy + qz * fz);
+        // The world is static, so relative to the camera the point moves with -velocity.
+        double wx = -(vx * rx + vy * ry + vz * rz);
+        double wy = -(vx * ux + vy * uy + vz * uz);
+        double wz = -(vx * fx + vy * fy + vz * fz);
+        // Screen-space velocity of a perspective-projected point (common 1/z^2 factor dropped).
+        double dirX = wx * cz - cx * wz;
+        double dirY = wy * cz - cy * wz;
+        if (dirX * dirX + dirY * dirY < 1.0e-12) return 0.0f;
+        return (float) (ROLL_SIGN * Math.atan2(-dirX, dirY));
+    }
+}
diff --git a/src/client/java/cinematic/snowstorm/effects/WindGusts.java b/src/client/java/cinematic/snowstorm/effects/WindGusts.java
new file mode 100644
index 0000000..972da52
--- /dev/null
+++ b/src/client/java/cinematic/snowstorm/effects/WindGusts.java
@@ -0,0 +1,57 @@
+package cinematic.snowstorm.effects;
+
+import cinematic.snowstorm.config.SnowfallConfig;
+
+/**
+ * Wind gusts: a slowly pulsing extra wind vector that is added on top of the configured wind.
+ * The configured WIND_STRENGTH / WIND_ANGLE are never modified (so they are saved untouched);
+ * snow particles just add {@link #getGustX()} / {@link #getGustZ()} to their per-tick movement.
+ */
+public final class WindGusts {
+    // Gust speed in blocks per tick at GUST_STRENGTH = 1.0.
+    private static final double BASE_AMPLITUDE = 0.03;
+    // Fade-in after snow starts / the effect is enabled, so gusts never pop in.
+    private static final int RAMP_TICKS = 60;
+
+    private static double phase;
+    private static int ramp;
+    private static float gustX;
+    private static float gustZ;
+
+    private WindGusts() {}
+
+    public static void tick(boolean snowing) {
+        if (!SnowfallConfig.ENABLE_WIND_GUSTS || !snowing) {
+            gustX = 0f;
+            gustZ = 0f;
+            ramp = 0;
+            return;
+        }
+        if (ramp < RAMP_TICKS) ramp++;
+
+        // Phase accumulates, so changing the period in the menu never makes the gust jump.
+        double periodTicks = Math.max(3.0, SnowfallConfig.GUST_PERIOD_SECONDS) * 20.0;
+        phase += Math.PI * 2.0 / periodTicks;
+        if (phase > Math.PI * 200.0) phase -= Math.PI * 200.0;
+
+        // Two layers with unrelated periods: no obviously repeating pattern.
+        double mix = 0.65 * Math.sin(phase) + 0.35 * Math.sin(phase * 2.7 + 1.3);
+        double gust = Math.max(0.0, mix);
+        gust *= gust; // short sharp gusts with calm in between
+
+        // Gusts also swing a little around the configured wind direction.
+        double angle = Math.toRadians(SnowfallConfig.WIND_ANGLE) + 0.35 * Math.sin(phase * 0.6 + 0.7);
+        double amplitude = BASE_AMPLITUDE * Math.max(0.0, SnowfallConfig.GUST_STRENGTH)
+                * gust * ((double) ramp / RAMP_TICKS);
+        gustX = (float) (Math.cos(angle) * amplitude);
+        gustZ = (float) (Math.sin(angle) * amplitude);
+    }
+
+    public static float getGustX() {
+        return gustX;
+    }
+
+    public static float getGustZ() {
+        return gustZ;
+    }
+}
